</style><style id="acrobat-touch-point-cta-style">
    .acrobat-touch-point {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        box-sizing: border-box;
        height: 24px;
        padding: 0 8px;
        gap: 4px;
        border: 1px solid rgb(209, 209, 209);
        border-radius: 4px;
        background: #FFFFFF;
        font-family: "AdobeClean-Regular", sans-serif;
        font-size: 12px;
        font-weight: 400;
        color: #201F1E;
        cursor: pointer;
        pointer-events: all;
        text-decoration: none;
        vertical-align: middle;
    }

    .acrobat-touch-point:hover,
    .acrobat-touch-point:active,
    .acrobat-touch-point:focus {
        background: #EEEEEE;
    }

    .acrobat-touch-point:focus-visible {
        outline: 1px solid #000000;
        outline-offset: -1px;
    }

    .acrobat-touch-point > .acrobat-icon {
        width: 14px;
        height: 14px;
        flex-shrink: 0;
        vertical-align: middle;
    }

    .acrobat-touch-point-text {
        display: flex;
        align-items: center;
        line-height: normal;
        overflow: hidden;
        transition: width 300ms ease;
    }

    /* Baseline for render()'s opt-in hoverAnimation config — no-op unless touchPointTextClass is
       left at the default (an override supplies its own CSS instead). */
    .minify .acrobat-touch-point-text {
        width: 0;
        opacity: 0;
    }

    .acrobat-touch-point-text.fade-effect {
        mask-image: linear-gradient(to right, rgba(0, 0, 0, 1) 0, rgba(0, 0, 0, 1) calc(100% - 16px), rgba(0, 0, 0, 0) 100%);
        -webkit-mask-image: linear-gradient(to right, rgba(0, 0, 0, 1) 0, rgba(0, 0, 0, 1) calc(100% - 16px), rgba(0, 0, 0, 0) 100%);
    }

    /* Hover/focus tooltip for this CTA (touchpoint-tooltip.js); it has no template of its own. */
    .acrobat-touch-point-tooltip {
        position: fixed;
        z-index: 2147483647;
        max-width: 240px;
        padding: 4px 8px;
        border-radius: 4px;
        background: #323232;
        color: #FFFFFF;
        font-family: "AdobeClean-Regular", sans-serif;
        font-size: 12px;
        line-height: 16px;
        white-space: nowrap;
        pointer-events: none;
    }
</style><style nonce="" type="text/css" data-late-css="">.boqHighlightVe [jslog]{box-shadow:0 0 0 5px #7fffd4}sentinel{}</style><style type="text/css"></style><style>[_nghost-ng-c2332002910]{display:-webkit-box;display:-webkit-flex;display:-moz-box;display:-ms-flexbox;display:flex;-webkit-box-orient:vertical;-webkit-box-direction:normal;-webkit-flex-direction:column;-moz-box-orient:vertical;-moz-box-direction:normal;-ms-flex-direction:column;flex-direction:column;height:100%}</style><style>.app-upsell-banner[_ngcontent-ng-c3302717058]{position:relative;z-index:2}.sticky-live-prompt-list[_ngcontent-ng-c3302717058]{position:relative;z-index:3}  crust-task{z-index:1002}  .picker-api-container{z-index:1000;position:absolute;inset:0;width:100%;height:100%}@media screen and (max-width:959.98px){  .one-picker-fullscreen.picker-api-container{position:fixed;inset:0;width:100vw;height:100dvh;z-index:1000;border-radius:var(--gem-sys-shape--corner-none)}  .one-picker-fullscreen.picker-api-container:before{content:"";position:fixed;inset:0;background-color:rgba(0,0,0,.5);z-index:-1}  .one-picker-fullscreen.picker-api-container .picker-iframe-container,   .one-picker-fullscreen.picker-api-container iframe{width:100%;max-width:100%;height:100%;max-height:100%;border-radius:var(--gem-sys-shape--corner-none)}}.side-nav-menu-button[_ngcontent-ng-c3302717058]{position:fixed;top:var(--internal-bar-offset,0);min-height:48px;-webkit-box-pack:center;-webkit-justify-content:center;-moz-box-pack:center;-ms-flex-pack:center;justify-content:center;-webkit-box-align:center;-webkit-align-items:center;-moz-box-align:center;-ms-flex-align:center;align-items:center;display:-webkit-box;display:-webkit-flex;display:-moz-box;display:-ms-flexbox;display:flex;color:var(--bard-color-onegooglebar-product-controls);margin-top:12px;-webkit-margin-start:16px;-moz-margin-start:16px;margin-inline-start:16px;z-index:4}.share-route[_nghost-ng-c3302717058]   .side-nav-menu-button[_ngcontent-ng-c3302717058]   .ge
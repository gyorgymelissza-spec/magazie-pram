  <span class="hljs-attr">"name"</span>: <span class="hljs-string">"Magazie PRAM DEER"</span>,
  <span class="hljs-attr">"short_name"</span>: <span class="hljs-string">"Magazie PRAM"</span>,
  <span class="hljs-attr">"description"</span>: <span class="hljs-string">"Gestiune stocuri și echipamente"</span>,
  <span class="hljs-attr">"start_url"</span>: <span class="hljs-string">"./index.html"</span>,
  <span class="hljs-attr">"display"</span>: <span class="hljs-string">"standalone"</span>,
  <span class="hljs-attr">"background_color"</span>: <span class="hljs-string">"#ffffff"</span>,
  <span class="hljs-attr">"theme_color"</span>: <span class="hljs-string">"#0056b3"</span>,
  <span class="hljs-attr">"icons"</span>: [
    {
      <span class="hljs-attr">"src"</span>: <span class="hljs-string">"icon-192.png"</span>,
      <span class="hljs-attr">"sizes"</span>: <span class="hljs-string">"192x192"</span>,
      <span class="hljs-attr">"type"</span>: <span class="hljs-string">"image/png"</span>
    },
    {
      <span class="hljs-attr">"src"</span>: <span class="hljs-string">"icon-512.png"</span>,
      <span class="hljs-attr">"sizes"</span>: <span class="hljs-string">"512x512"</span>,
      <span class="hljs-attr">"type"</span>: <span class="hljs-string">"image/png"</span>
    }
  ]
}
</code></pre><!----></div></div></div><!----><!----><!----></code-block><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----></response-element><p data-path-to-node="5"><i data-path-to-node="5" data-index-in-node="0">Parametrul <code data-path-to-node="5" data-index-in-node="11">"display": "standalone"</code> este cel care ascunde bara de navigare a browserului.</i></p><h3 data-path-to-node="6">Pasul 2: Adaugă imaginile pentru iconiță</h3><p data-path-to-node="7">Va trebui să salvezi o imagine (poate fi un simbol electric sau un logo) pe care să o denumești <code data-path-to-node="7" data-index-in-node="96">icon-192.png</code> (dimensiunea 192x192 pixeli) și o versiune mai mare <code data-path-to-node="7" data-index-in-node="161">icon-512.png</code> (512x512 pixeli). Pune aceste două imagini exact în același folder cu fișierul HTML.</p><h3 data-path-to-node="8">Pasul 3: Leagă fișierul în <code data-path-to-node="8" data-index-in-node="27">index.html</code></h3><p data-path-to-node="9">Deschide fișierul tău <code data-path-to-node="9" data-index-in-node="22">index.html</code> și copiază aceste trei rânduri chiar sus, în interiorul secțiunii <code data-path-to-node="9" data-index-in-node="99">&lt;head&gt; ... &lt;/head&gt;</code>:</p><response-element class="no-md md-has-block-component" ng-version="0.0.0-PLACEHOLDER"><!----><!----><!----><!----><!----><!----><code-block _nghost-ng-c3786462746="" class="ng-tns-c3786462746-32 enable-luminous-code-blo
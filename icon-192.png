    <span class="hljs-selector-class">.modal-content</span> { <span class="hljs-attribute">background</span>: white; <span class="hljs-attribute">padding</span>: <span class="hljs-number">20px</span>; <span class="hljs-attribute">border-radius</span>: <span class="hljs-number">8px</span>; <span class="hljs-attribute">width</span>: <span class="hljs-number">90%</span>; <span class="hljs-attribute">max-width</span>: <span class="hljs-number">400px</span>; }
    <span class="hljs-selector-class">.close-btn</span> { <span class="hljs-attribute">background</span>: <span class="hljs-number">#6c757d</span>; <span class="hljs-attribute">color</span>: white; <span class="hljs-attribute">width</span>: <span class="hljs-number">100%</span>; <span class="hljs-attribute">margin-top</span>: <span class="hljs-number">15px</span>; }
    <span class="hljs-selector-tag">table</span> { <span class="hljs-attribute">width</span>: <span class="hljs-number">100%</span>; <span class="hljs-attribute">border-collapse</span>: collapse; <span class="hljs-attribute">margin-top</span>: <span class="hljs-number">10px</span>; <span class="hljs-attribute">font-size</span>: <span class="hljs-number">0.9rem</span>; }
    <span class="hljs-selector-tag">th</span>, <span class="hljs-selector-tag">td</span> { <span class="hljs-attribute">border</span>: <span class="hljs-number">1px</span> solid <span class="hljs-number">#ddd</span>; <span class="hljs-attribute">padding</span>: <span class="hljs-number">8px</span>; <span class="hljs-attribute">text-align</span>: left; }
    <span class="hljs-selector-tag">th</span> { <span class="hljs-attribute">background-color</span>: <span class="hljs-number">#f2f2f2</span>; }
  </span><span class="hljs-tag">&lt;/<span class="hljs-name">style</span>&gt;</span>
<span class="hljs-tag">&lt;/<span class="hljs-name">head</span>&gt;</span>
<span class="hljs-tag">&lt;<span class="hljs-name">body</span>&gt;</span>

  <span class="hljs-tag">&lt;<span class="hljs-name">header</span>&gt;</span>
    <span class="hljs-tag">&lt;<span class="hljs-name">h1</span>&gt;</span>Magazie PRAM<span class="hljs-tag">&lt;/<span class="hljs-name">h1</span>&gt;</span>
    <span class="hljs-tag">&lt;<span class="hljs-name">button</span> <span class="hljs-attr">class</span>=<span class="hljs-string">"btn-history"</span> <span class="hljs-attr">onclick</span>=<span class="hljs-string">"openHistory()"</span>&gt;</span>Istoric<span class="hljs-tag">&lt;/<span class="hljs-name">button</span>&gt;</span>
  <span class="hljs-tag">&lt;/<span class="hljs-name">header</span>&gt;</span>

  <span class="hljs-tag">&lt;<span class="hljs-name">div</span> <span class="hljs-attr">class</span>=<span class="hljs-string">"container"</span>&gt;</span>
    <span class="hljs-tag">&lt;<span class="hljs-name">input</span> <span class="hljs-attr">type</span>=<span class="hljs-string">"text"</span> <span class="hljs-attr">id</span>=<span class="hljs-string">"searchInput"</span> <span class="hljs-attr">placeholder</span>=<span class="hljs-string">"Caută material (ex: cleme, siguranțe)..."</span> <span class="hljs-attr">onkeyup</span>=<span class="hljs-string">"filterItems()"</span>&gt;</span>
    
    <span class="hljs-tag">&lt;<span class="hljs-name">div</span> <span class="hljs-attr">style</span>=<span class="hljs-string">"background: white; padding: 15px; border-radius: 8px; margin-bottom: 20px; border: 1px solid #ddd;"</span>&gt;</span>
      <span class="hljs-tag">&lt;<span class="hljs-name">h3</span> <span class="hljs-attr">style</span>=<span class="hljs-string">"margin-top: 0;"</span>&gt;</span>Adaugă material nou<span class="hljs-tag">&lt;/<span class="hljs-name">h3</span>&gt;</span>
      <span class="hljs-tag">&lt;<span class="hljs-name">input</span> <span class="hljs-attr">type</span>=<span class="hljs-string">"text"</span> <span class="hljs-attr">id</span>=<span class="hljs-string">"newItemName"</span> <span class="hljs-attr">placeholder</span>=<span class="hljs-string">"Nume material"</span>&gt;</span>
      <span class="hljs-tag">&lt;<span class="hljs-name">input</span> <span class="hljs-attr">type</span>=<span class="hljs-string">"number"</span> <span class="hljs-attr">id</span>=<span class="hljs-string">"newItemQty"</span> <span class="hljs-attr">placeholder</span>=<span class="hljs-string">"Cantitate inițială"</span>&gt;</span>
      <span class="hljs-tag">&lt;<span class="hljs-name">button</span> <span class="hljs-attr">class</span>=<span class="hljs-string">"btn-add"</span> <span class="hljs-attr">onclick</span>=<span class="hljs-string">"addNewItem()"</span> <span class="hljs-attr">style</span>=<span class="hljs-string">"width: 100%;"</span>&gt;</span>Creează în baza de date<span class="hljs-tag">&lt;/<span class="hljs-name">button</span>&gt;</span>
    <span class="hljs-tag">&lt;/<span class="hljs-name">div</span>&gt;</span>

    <span class="hljs-tag">&lt;<span class="hljs-name">div</span> <span class="hljs-attr">id</span>=<span class="hljs-string">"inventoryList"</span>&gt;</span>
      <span class="hljs-comment">&lt;!-- Aici se vor încărca materialele automat din baza de date --&gt;</span>
    <span class="hljs-tag">&lt;/<span class="hljs-name">div</span>&gt;</span>
  <span class="hljs-tag">&lt;/<span class="hljs-name">div</span>&gt;</span>

  <span class="hljs-comment">&lt;!-- Fereastra pentru Adăugare/Extragere (Tranzacție) --&gt;</span>
  <span class="hljs-tag">&lt;<span class="hljs-name">div</span> <span class="hljs-attr">id</span>=<span class="hljs-string">"transactionModal"</span> <span class="hljs-attr">class</span>=<span class="hljs-string">"modal"</span>&gt;</span>
    <span class="hljs-tag">&lt;<span class="hljs-name">div</span> <span class="hljs-attr">class</span>=<span class="hljs-string">"modal-content"</span>&gt;</span>
      <span class="hljs-tag">&lt;<span class="hljs-name">h3</span> <span class="hljs-attr">id</span>=<span class="hljs-string">"modalItemName"</span> <span class="hljs-attr">style</span>=<span class="hljs-string">"margin-top:0; color:#0056b3;"</span>&gt;</span>Nume Material<span class="hljs-tag">&lt;/<span class="hljs-name">h3</span>&gt;</span>
      
      <span class="hljs-comment">&lt;!-- ========================================== --&gt;</span>
      <span class="hljs-comment">&lt;!-- 1. MODIFICĂ AICI: LISTA ELECTRICIENILOR --&gt;</span>
      <span class="hljs-comment">&lt;!-- ========================================== --&gt;</span>
      <span class="hljs-tag">&lt;<span class="hljs-name">select</span> <span class="hljs-attr">id</span>=<span class="hljs-string">"electricianName"</span>&gt;</span>
        <span class="hljs-tag">&lt;<span class="hljs-name">option</span> <span class="hljs-attr">value</span>=<span class="hljs-string">""</span>&gt;</span>-- Cine modifică stocul? --<span class="hljs-tag">&lt;/<span class="hljs-name">option</span>&gt;</span>
        <span class="hljs-tag">&lt;<span class="hljs-name">option</span> <span class="hljs-attr">value</span>=<span class="hljs-string">"Coleg 1"</span>&gt;</span>Coleg 1<span class="hljs-tag">&lt;/<span class="hljs-name">option</span>&gt;</span>
        <span class="hljs-tag">&lt;<span class="hljs-name">option</span> <span class="hljs-attr">value</span>=<span class="hljs-string">"Coleg 2"</span>&gt;</span>Coleg 2<span class="hljs-tag">&lt;/<span class="hljs-name">option</span>&gt;</span>
        <span class="hljs-tag">&lt;<span class="hljs-name">option</span> <span class="hljs-attr">value</span>=<span class="hljs-string">"Coleg 3"</span>&gt;</span>Coleg 3<span class="hljs-tag">&lt;/<span class="hljs-name">option</span>&gt;</span>
      <span class="hljs-tag">&lt;/<span class="hljs-name">select</span>&gt;</span>
      
      <span class="hljs-tag">&lt;<span class="hljs-name">input</span> <span class="hljs-attr">type</span>=<span class="hljs-string">"number"</span> <span class="hljs-attr">id</span>=<span class="hljs-string">"transactionQty"</span> <span class="hljs-attr">placeholder</span>=<span class="hljs-string">"Introdu cantitatea"</span>&gt;</span>
      
      <span class="hljs-tag">&lt;<span class="hljs-name">div</span> <span class="hljs-attr">style</span>=<span class="hljs-string">"display: flex; gap: 10px; margin-top: 15px;"</span>&gt;</span>
        <span class="hljs-tag">&lt;<span class="hljs-name">button</span> <span class="hljs-attr">class</span>=<span class="hljs-string">"btn-add"</span> <span class="hljs-attr">style</span>=<span class="hljs-string">"flex: 1;"</span> <span class="hljs-attr">onclick</span>=<span class="hljs-string">"submitTransaction('add')"</span>&gt;</span>+ Adaugă<span class="hljs-tag">&lt;/<span class="hljs-name">button</span>&gt;</span>
        <span class="hljs-tag">&lt;<span class="hljs-name">button</span> <span class="hljs-attr">class</span>=<span class="hljs-string">"btn-remove"</span> <span class="hljs-attr">style</span>=<span class="hljs-string">"flex: 1;"</span> <span class="hljs-attr">onclick</span>=<span class="hljs-string">"submitTransaction('remove')"</span>&gt;</span>- Extrage<span class="hljs-tag">&lt;/<span class="hljs-name">button</span>&gt;</span>
      <span class="hljs-tag">&lt;/<span class="hljs-name">div</span>&gt;</span>
      <span class="hljs-tag">&lt;<span class="hljs-name">button</span> <span class="hljs-attr">class</span>=<span class="hljs-string">"close-btn"</span> <span class="hljs-attr">onclick</span>=<span class="hljs-string">"closeModal('transactionModal')"</span>&gt;</span>Anulează<span class="hljs-tag">&lt;/<span class="hljs-name">button</span>&gt;</span>
    <span class="hljs-tag">&lt;/<span class="hljs-name">div</span>&gt;</span>
  <span class="hljs-tag">&lt;/<span class="hljs-name">div</span>&gt;</span>

  <span class="hljs-comment">&lt;!-- Fereastra pentru Istoric --&gt;</span>
  <span class="hljs-tag">&lt;<span class="hljs-name">div</span> <span class="hljs-attr">id</span>=<span class="hljs-string">"historyModal"</span> <span class="hljs-attr">class</span>=<span class="hljs-string">"modal"</span>&gt;</span>
    <span class="hljs-tag">&lt;<span class="hljs-name">div</span> <span class="hljs-attr">class</span>=<span class="hljs-string">"modal-content"</span> <span class="hljs-attr">style</span>=<span class="hljs-string">"max-width: 600px; max-height: 80vh; overflow-y: auto;"</span>&gt;</span>
      <span class="hljs-tag">&lt;<span class="hljs-name">h3</span> <span class="hljs-attr">style</span>=<span class="hljs-string">"margin-top:0;"</span>&gt;</span>Istoric Mișcări<span class="hljs-tag">&lt;/<span class="hljs-name">h3</span>&gt;</span>
      <span class="hljs-tag">&lt;<span class="hljs-name">table</span>&gt;</span>
        <span class="hljs-tag">&lt;<span class="hljs-name">thead</span>&gt;</span>
          <span class="hljs-tag">&lt;<span class="hljs-name">tr</span>&gt;</span>
            <span class="hljs-tag">&lt;<span class="hljs-name">th</span>&gt;</span>Data<span class="hljs-tag">&lt;/<span class="hljs-name">th</span>&gt;</span>
            <span class="hljs-tag">&lt;<span class="hljs-name">th</span>&gt;</span>Nume<span class="hljs-tag">&lt;/<span class="hljs-name">th</span>&gt;</span>
            <span class="hljs-tag">&lt;<span class="hljs-name">th</span>&gt;</span>Material<span class="hljs-tag">&lt;/<span class="hljs-name">th</span>&gt;</span>
            <span class="hljs-tag">&lt;<span class="hljs-name">th</span>&gt;</span>Buc.<span class="hljs-tag">&lt;/<span class="hljs-name">th</span>&gt;</span>
          <span class="hljs-tag">&lt;/<span class="hljs-name">tr</span>&gt;</span>
        <span class="hljs-tag">&lt;/<span class="hljs-name">thead</span>&gt;</span>
        <span class="hljs-tag">&lt;<span class="hljs-name">tbody</span> <span class="hljs-attr">id</span>=<span class="hljs-string">"historyTableBody"</span>&gt;</span>
          <span class="hljs-comment">&lt;!-- Istoricul se va încărca aici --&gt;</span>
        <span class="hljs-tag">&lt;/<span class="hljs-name">tbody</span>&gt;</span>
      <span class="hljs-tag">&lt;/<span class="hljs-name">table</span>&gt;</span>
      <span class="hljs-tag">&lt;<span class="hljs-name">button</span> <span class="hljs-attr">class</span>=<span class="hljs-string">"close-btn"</span> <span class="hljs-attr">onclick</span>=<span class="hljs-string">"closeModal('historyModal')"</span>&gt;</span>Închide<span class="hljs-tag">&lt;/<span class="hljs-name">button</span>&gt;</span>
    <span class="hljs-tag">&lt;/<span class="hljs-name">div</span>&gt;</span>
  <span class="hljs-tag">&lt;/<span class="hljs-name">div</span>&gt;</span>

  <span class="hljs-comment">&lt;!-- Logica și conexiunea cu Firebase --&gt;</span>
  <span class="hljs-tag">&lt;<span class="hljs-name">script</span> <span class="hljs-attr">type</span>=<span class="hljs-string">"module"</span>&gt;</span><span class="javascript">
    <span class="hljs-keyword">import</span> { initializeApp } <span class="hljs-keyword">from</span> <span class="hljs-string">"https://www.gstatic.com/firebasejs/10.5.0/firebase-app.js"</span>;
    <span class="hljs-keyword">import</span> { getFirestore, collection, onSnapshot, doc, updateDoc, addDoc, serverTimestamp, query, orderBy } <span class="hljs-keyword">from</span> <span class="hljs-string">"https://www.gstatic.com/firebasejs/10.5.0/firebase-firestore.js"</span>;

    <span class="hljs-comment">// ==========================================</span>
    <span class="hljs-comment">// 2. MODIFICĂ AICI: DATELE TALE FIREBASE</span>
    <span class="hljs-comment">// ==========================================</span>
    <span class="hljs-keyword">const</span> firebaseConfig = {
      <span class="hljs-attr">apiKey</span>: <span class="hljs-string">"AICI_PUI_API_KEY"</span>,
      <span class="hljs-attr">authDomain</span>: <span class="hljs-string">"nume-proiect.firebaseapp.com"</span>,
      <span class="hljs-attr">projectId</span>: <span class="hljs-string">"nume-proiect"</span>,
      <span class="hljs-attr">storageBucket</span>: <span class="hljs-string">"nume-proiect.appspot.com"</span>,
      <span class="hljs-attr">messagingSenderId</span>: <span class="hljs-string">"123456789"</span>,
      <span class="hljs-attr">appId</span>: <span class="hljs-string">"1:123456789:web:abcdef"</span>
    };

    <span class="hljs-comment">// Inițializare aplicație Firebase</span>
    <span class="hljs-keyword">const</span> app = initializeApp(firebaseConfig);
    <span class="hljs-keyword">const</span> db = getFirestore(app);
    
    <span class="hljs-keyword">let</span> currentItemId = <span class="hljs-string">''</span>;
    <span class="hljs-keyword">let</span> currentItemStock = <span class="hljs-number">0</span>;
    <span class="hljs-keyword">let</span> currentItemNameText = <span class="hljs-string">''</span>;

    <span class="hljs-comment">// Afișează stocurile în timp real</span>
    onSnapshot(collection(db, <span class="hljs-string">"stocuri"</span>), <span class="hljs-function">(<span class="hljs-params">snapshot</span>) =&gt;</span> {
      <span class="hljs-keyword">const</span> list = <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">"inventoryList"</span>);
      list.innerHTML = <span class="hljs-string">''</span>;
      snapshot.forEach(<span class="hljs-function">(<span class="hljs-params">doc</span>) =&gt;</span> {
        <span class="hljs-keyword">const</span> item = doc.data();
        list.innerHTML += <span class="hljs-string">`
          &lt;div class="card item-card"&gt;
            &lt;div&gt;
              &lt;h3 class="item-name"&gt;<span class="hljs-subst">${item.nume}</span>&lt;/h3&gt;
              &lt;p style="margin:0; color:#555;"&gt;Stoc: &lt;strong&gt;<span class="hljs-subst">${item.cantitate}</span>&lt;/strong&gt; buc.&lt;/p&gt;
            &lt;/div&gt;
            &lt;div&gt;
              &lt;button class="btn-history" onclick="openTransactionModal('<span class="hljs-subst">${doc.id}</span>', '<span class="hljs-subst">${item.nume}</span>', <span class="hljs-subst">${item.cantitate}</span>)"&gt;Modifică&lt;/button&gt;
            &lt;/div&gt;
          &lt;/div&gt;
        `</span>;
      });
    });

    <span class="hljs-comment">// Afișează istoricul în timp real</span>
    <span class="hljs-keyword">const</span> q = query(collection(db, <span class="hljs-string">"istoric"</span>), orderBy(<span class="hljs-string">"data"</span>, <span class="hljs-string">"desc"</span>));
    onSnapshot(q, <span class="hljs-function">(<span class="hljs-params">snapshot</span>) =&gt;</span> {
      <span class="hljs-keyword">const</span> tbody = <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">"historyTableBody"</span>);
      tbody.innerHTML = <span class="hljs-string">''</span>;
      snapshot.forEach(<span class="hljs-function">(<span class="hljs-params">doc</span>) =&gt;</span> {
        <span class="hljs-keyword">const</span> tx = doc.data();
        <span class="hljs-keyword">const</span> dateStr = tx.data ? tx.data.toDate().toLocaleString(<span class="hljs-string">'ro-RO'</span>, {<span class="hljs-attr">day</span>:<span class="hljs-string">'2-digit'</span>, <span class="hljs-attr">month</span>:<span class="hljs-string">'2-digit'</span>, <span class="hljs-attr">hour</span>:<span class="hljs-string">'2-digit'</span>, <span class="hljs-attr">minute</span>:<span class="hljs-string">'2-digit'</span>}) : <span class="hljs-string">'Acum'</span>;
        <span class="hljs-keyword">const</span> color = tx.tip === <span class="hljs-string">'add'</span> ? <span class="hljs-string">'#28a745'</span> : <span class="hljs-string">'#dc3545'</span>;
        <span class="hljs-keyword">const</span> sign = tx.tip === <span class="hljs-string">'add'</span> ? <span class="hljs-string">'+'</span> : <span class="hljs-string">'-'</span>;
        
        tbody.innerHTML += <span class="hljs-string">`
          &lt;tr&gt;
            &lt;td&gt;<span class="hljs-subst">${dateStr}</span>&lt;/td&gt;
            &lt;td&gt;<span class="hljs-subst">${tx.electrician}</span>&lt;/td&gt;
            &lt;td&gt;<span class="hljs-subst">${tx.material}</span>&lt;/td&gt;
            &lt;td style="color: <span class="hljs-subst">${color}</span>; font-weight: bold;"&gt;<span class="hljs-subst">${sign}</span><span class="hljs-subst">${tx.cantitate}</span>&lt;/td&gt;
          &lt;/tr&gt;
        `</span>;
      });
    });

    <span class="hljs-comment">// Creare material nou</span>
    <span class="hljs-built_in">window</span>.addNewItem = <span class="hljs-keyword">async</span> <span class="hljs-function"><span class="hljs-keyword">function</span>(<span class="hljs-params"></span>) </span>{
      <span class="hljs-keyword">const</span> nume = <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">"newItemName"</span>).value;
      <span class="hljs-keyword">const</span> cantitate = <span class="hljs-built_in">parseInt</span>(<span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">"newItemQty"</span>).value);
      <span class="hljs-keyword">if</span> (nume &amp;&amp; cantitate &gt;= <span class="hljs-number">0</span>) {
        <span class="hljs-keyword">await</span> addDoc(collection(db, <span class="hljs-string">"stocuri"</span>), { <span class="hljs-attr">nume</span>: nume, <span class="hljs-attr">cantitate</span>: cantitate });
        <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">"newItemName"</span>).value = <span class="hljs-string">''</span>;
        <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">"newItemQty"</span>).value = <span class="hljs-string">''</span>;
      } <span class="hljs-keyword">else</span> {
        alert(<span class="hljs-string">"Te rog introdu un nume și o cantitate validă."</span>);
      }
    };

    <span class="hljs-comment">// Deschidere fereastră tranzacție</span>
    <span class="hljs-built_in">window</span>.openTransactionModal = <span class="hljs-function"><span class="hljs-keyword">function</span>(<span class="hljs-params">id, name, stock</span>) </span>{
      currentItemId = id;
      currentItemNameText = name;
      currentItemStock = stock;
      <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">"modalItemName"</span>).innerText = name;
      <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">"transactionQty"</span>).value = <span class="hljs-string">''</span>;
      <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">"electricianName"</span>).value = <span class="hljs-string">''</span>;
      <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">"transactionModal"</span>).style.display = <span class="hljs-string">"flex"</span>;
    };

    <span class="hljs-comment">// Confirmare Adăugare sau Extragere</span>
    <span class="hljs-built_in">window</span>.submitTransaction = <span class="hljs-keyword">async</span> <span class="hljs-function"><span class="hljs-keyword">function</span>(<span class="hljs-params">tip</span>) </span>{
      <span class="hljs-keyword">const</span> qty = <span class="hljs-built_in">parseInt</span>(<span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">"transactionQty"</span>).value);
      <span class="hljs-keyword">const</span> electrician = <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">"electricianName"</span>).value;

      <span class="hljs-keyword">if</span> (!electrician) { alert(<span class="hljs-string">"Selectează electricianul!"</span>); <span class="hljs-keyword">return</span>; }
      <span class="hljs-keyword">if</span> (!qty || qty &lt;= <span class="hljs-number">0</span>) { alert(<span class="hljs-string">"Introdu o cantitate mai mare ca zero!"</span>); <span class="hljs-keyword">return</span>; }

      <span class="hljs-keyword">let</span> newStock = currentItemStock;
      <span class="hljs-keyword">if</span> (tip === <span class="hljs-string">'add'</span>) {
        newStock += qty;
      } <span class="hljs-keyword">else</span> <span class="hljs-keyword">if</span> (tip === <span class="hljs-string">'remove'</span>) {
        <span class="hljs-keyword">if</span> (qty &gt; currentItemStock) { alert(<span class="hljs-string">"Atenție! Nu poți extrage mai mult decât ai pe stoc."</span>); <span class="hljs-keyword">return</span>; }
        newStock -= qty;
      }

      <span class="hljs-comment">// Actualizăm stocul în Firebase</span>
      <span class="hljs-keyword">await</span> updateDoc(doc(db, <span class="hljs-string">"stocuri"</span>, currentItemId), { <span class="hljs-attr">cantitate</span>: newStock });

      <span class="hljs-comment">// Salvăm mișcarea în istoric</span>
      <span class="hljs-keyword">await</span> addDoc(collection(db, <span class="hljs-string">"istoric"</span>), {
        <span class="hljs-attr">material</span>: currentItemNameText,
        <span class="hljs-attr">electrician</span>: electrician,
        <span class="hljs-attr">cantitate</span>: qty,
        <span class="hljs-attr">tip</span>: tip,
        <span class="hljs-attr">data</span>: serverTimestamp()
      });

      closeModal(<span class="hljs-string">'transactionModal'</span>);
    };

    <span class="hljs-comment">// Funcția pentru motorul de căutare</span>
    <span class="hljs-built_in">window</span>.filterItems = <span class="hljs-function"><span class="hljs-keyword">function</span>(<span class="hljs-params"></span>) </span>{
      <span class="hljs-keyword">const</span> input = <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">"searchInput"</span>).value.toLowerCase();
      <span class="hljs-keyword">const</span> cards = <span class="hljs-built_in">document</span>.getElementsByClassName(<span class="hljs-string">"item-card"</span>);
      <span class="hljs-keyword">for</span> (<span class="hljs-keyword">let</span> i = <span class="hljs-number">0</span>; i &lt; cards.length; i++) {
        <span class="hljs-keyword">const</span> name = cards[i].getElementsByClassName(<span class="hljs-string">"item-name"</span>)[<span class="hljs-number">0</span>].innerText.toLowerCase();
        cards[i].style.display = name.includes(input) ? <span class="hljs-string">"flex"</span> : <span class="hljs-string">"none"</span>;
      }
    };

    <span class="hljs-comment">// Închidere/Deschidere ferestre (Modals)</span>
    <span class="hljs-built_in">window</span>.openHistory = <span class="hljs-function"><span class="hljs-keyword">function</span>(<span class="hljs-params"></span>) </span>{ <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">"historyModal"</span>).style.display = <span class="hljs-string">"flex"</span>; };
    <span class="hljs-built_in">window</span>.closeModal = <span class="hljs-function"><span class="hljs-keyword">function</span>(<span class="hljs-params">id</span>) </span>{ <span class="hljs-built_in">document</span>.getElementById(id).style.display = <span class="hljs-string">"none"</span>; };
  </span><span class="hljs-tag">&lt;/<span class="hljs-name">script</span>&gt;</span>

  <span class="hljs-comment">&lt;!-- Script necesar pentru iconița de pe telefon --&gt;</span>
  <span class="hljs-tag">&lt;<span class="hljs-name">script</span>&gt;</span><span class="javascript">
    <span class="hljs-keyword">if</span> (<span class="hljs-string">'serviceWorker'</span> <span class="hljs-keyword">in</span> navigator) {
      navigator.serviceWorker.register(<span class="hljs-string">'sw.js'</span>);
    }
  </span><span class="hljs-tag">&lt;/<span class="hljs-name">script</span>&gt;</span>
<span class="hljs-tag">&lt;/<span class="hljs-name">body</span>&gt;</span>
<span class="hljs-tag">&lt;/<span class="hljs-name">html</span>&gt;</span>
</code></pre><!----></div></div></div><!----><!----><!----></code-block><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----></response-element><p data-path-to-node="3"><span>După ce salvezi acest fișier cu modificările tale,</span><span> vei fi gata să treci la pasul cu GitHub.</span><span> Spune-mi dacă ai reușit să pui cheile Firebase!</span></p></div></message-content><!----><!----></div></structured-content-container><!----><!----><!----><!----></model-response-content><!----><!----><!----><div _ngcontent-ng-c1188584280="" class="response-footer has-thoughts gap complete"><!----><!----><!----><sources-list _ngcontent-ng-c1188584280="" class="sources-list ng-star-inserted"><!----></sources-list><!----><election-info-disclaimer _ngcontent-ng-c1188584280="" _nghost-ng-c3733613330="" style="display: none;" class="ng-star-inserted"><!----></election-info-disclaimer><finance-info-disclaimer _ngcontent-ng-c1188584280="" _nghost-ng-c446528241="" style="display: none;" class="ng-star-inserted"><!----></finance-info-disclaimer><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----></div></div><!----><!----><sensitive-memories-banner _ngcontent-ng-c1188584280="" _nghost-ng-c4215747216="" class="ng-star-inserted"><!----></sensitive-memories-banner><!----><!----><!----><!----><!----><!----></div></div><div _ngcontent-ng-c3774178123="" class="response-container-footer ng-tns-c3774178123-50 ng-star-inserted"><!---->